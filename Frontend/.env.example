# Backend URL — OPTIONAL (see src/config.js).
#
# Leave it EMPTY when the API and this SPA are served from the same domain
# (the normal production setup). Every API/asset URL then becomes relative
# ("/api/..."), so the app always talks to whatever origin served it and a
# stale build can never point users at a wrong or unreachable host.
#
# Set it ONLY when the backend is on a DIFFERENT origin than the SPA:
#   - local dev:  VITE_APP_URL=http://127.0.0.1:8000
#   - split prod: VITE_APP_URL=https://api.yourdomain.com
#
# Baked in at build time (Vite), not read at runtime — rebuild after changing.
VITE_APP_URL=http://127.0.0.1:8000
